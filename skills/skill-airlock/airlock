#!/usr/bin/env python3
"""skill-airlock: find, vet, use and unload agent skills, privately.

Python 3 stdlib (+ git for `sync`). No telemetry: the only network access is
`sync` fetching the sources listed in ~/.skill-airlock/sources.json.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _audit  # noqa: E402

VERSION = "0.2.0"
STATE = Path(os.environ.get("AIRLOCK_HOME") or Path.home() / ".skill-airlock")
AGENTS = {"claude": Path.home() / ".claude" / "skills", "agents": Path.home() / ".agents" / "skills"}
TRANSCRIPTS = Path.home() / ".claude" / "projects"
TRUST_BOOST = {"official": 0.5, "vendor": 0.25}
SAFE_NAME = _audit.SAFE_NAME
clean = _audit.sanitize
STOPWORDS = set("a an and or the to of for in on with by from as at is are be use used using when this that it its "
                "your you user users can will into via any all not do does skill skills".split())


class Fail(Exception):
    pass


# ---------- small helpers ----------

def now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def iso(t):
    return t.isoformat().replace("+00:00", "Z")


def parse_iso(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def parse_duration(s):
    m = re.fullmatch(r"(\d+)([smhdw])", s.strip())
    if not m:
        raise Fail(f"bad duration '{s}' (use e.g. 30m, 12h, 7d, 2w)")
    n = int(m.group(1))
    return dt.timedelta(**{{"s": "seconds", "m": "minutes", "h": "hours", "d": "days", "w": "weeks"}[m.group(2)]: n})


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return default


def save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)


def qid(skill_id):
    return re.sub(r"[^A-Za-z0-9._-]+", "--", skill_id)


def tree_hashes(root):
    """sha256 per file; symlinks are hashed by their target text, never followed."""
    out = {}
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        links = [d for d in dirnames if os.path.islink(os.path.join(dirpath, d))]
        dirnames[:] = [d for d in dirnames if d != ".git" and d not in links]
        for name in filenames + links:
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, root)
            if os.path.islink(full):
                out[rel] = "link:" + os.readlink(full)
            else:
                h = hashlib.sha256()
                with open(full, "rb") as fh:
                    for chunk in iter(lambda: fh.read(65536), b""):
                        h.update(chunk)
                out[rel] = h.hexdigest()
    return dict(sorted(out.items()))


def words(text):
    out = set()
    for w in re.findall(r"[a-z0-9][a-z0-9+#.-]*", text.lower()):
        w = w.strip(".-")
        if len(w) > 3 and w.endswith("s") and not w.endswith("ss"):
            w = w[:-1]
        if w and w not in STOPWORDS:
            out.add(w)
    return out


def human_age(ts, days):
    if not ts:
        return f">{days}d"
    days = (now() - parse_iso(ts)).days
    return "today" if days <= 0 else f"{days}d ago"


# ---------- sources, sync, index ----------

def load_sources():
    path = STATE / "sources.json"
    if not path.exists():
        STATE.mkdir(parents=True, exist_ok=True)
        shutil.copy(HERE / "sources.default.json", path)
    return load_json(path, {}).get("sources", [])


def git(*args, cwd=None):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    r = subprocess.run(["git", *args], cwd=cwd, env=env, capture_output=True, text=True, timeout=600)
    if r.returncode:
        raise Fail(f"git {args[0]} failed: {r.stderr.strip()[:300]}")
    return r.stdout.strip()


def materialize(src):
    """Return (root, commit, date) for a source, cloning or updating a shallow mirror if needed."""
    kind = src.get("type", "github")
    if kind == "path":
        root = Path(src["path"]).expanduser()
        if not root.is_dir():
            raise Fail(f"path not found: {root}")
        return root, "local", ""
    url = src["url"] if kind == "git" else f"https://github.com/{src['repo']}.git"
    mirror = STATE / "mirrors" / qid(src["id"])
    if (mirror / ".git").is_dir():
        git("fetch", "--depth", "1", "--quiet", "origin", "HEAD", cwd=mirror)
        git("reset", "--hard", "--quiet", "FETCH_HEAD", cwd=mirror)
    else:
        mirror.parent.mkdir(parents=True, exist_ok=True)
        git("clone", "--depth", "1", "--quiet", "--no-recurse-submodules", url, str(mirror))
    return mirror, git("rev-parse", "HEAD", cwd=mirror), git("log", "-1", "--format=%cs", cwd=mirror)


def scan_catalog(src, root, commit, date):
    entries, seen = [], set()
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = sorted(d for d in dirnames if d not in _audit.SKIP_DIRS and d != "fixtures")
        skill_md = os.path.join(dirpath, "SKILL.md")
        if "SKILL.md" not in filenames or os.path.islink(skill_md):
            continue
        with open(skill_md, encoding="utf-8", errors="replace") as fh:
            text = fh.read(200_000)
        meta, body_start = _audit.parse_frontmatter(text)
        raw_name = (meta.get("name") or os.path.basename(dirpath)).strip()
        name_ok = bool(SAFE_NAME.match(raw_name))
        name = raw_name if name_ok else qid(os.path.basename(dirpath))[:64]
        rel = os.path.relpath(dirpath, root)
        sid = f"{src['id']}/{name}"
        if sid in seen:
            sid = f"{src['id']}/{rel.replace(os.sep, '-')}"
        seen.add(sid)
        has_scripts = any(os.path.splitext(f)[1].lower() in _audit.SCRIPT_EXT
                          for _, _, fs in os.walk(dirpath) for f in fs)
        desc = meta.get("description", "")
        flags = _audit.instruction_hits(raw_name + "\n" + desc)
        if not name_ok:
            flags.append("unsafe-name")
        entries.append({"id": sid, "source": src["id"], "trust": src.get("trust", "community"), "name": name,
                        "description": desc, "path": rel, "commit": commit, "date": date,
                        "has_scripts": has_scripts, "flags": flags,
                        "desc_tokens": _audit.tokens(name + meta.get("description", "")),
                        "body_tokens": _audit.tokens("\n".join(text.splitlines()[body_start:]))})
    return entries


def cmd_sync(args):
    sources = load_sources()
    old = load_json(STATE / "index.json", {"skills": []})["skills"]
    entries = []
    for src in sources:
        if args.only and src["id"] not in args.only:
            entries += [e for e in old if e["source"] == src["id"]]
            continue
        try:
            root, commit, date = materialize(src)
            found = scan_catalog(src, root, commit, date)
            entries += found
            print(f"  ✓ {src['id']:<28} {len(found):>4} skills   {commit[:10]} {date}")
        except (Fail, KeyError, subprocess.TimeoutExpired) as e:
            kept = [x for x in old if x["source"] == src["id"]]
            entries += kept
            print(f"  ✗ {src['id']:<28} {e} (kept {len(kept)} from the previous sync)")
    save_json(STATE / "index.json", {"synced_at": iso(now()), "skills": entries})
    print(f"Index: {len(entries)} skills from {len(sources)} sources → {STATE / 'index.json'}")


def load_index():
    idx = load_json(STATE / "index.json", None)
    if not idx or not idx.get("skills"):
        raise Fail("the index is empty: run `airlock sync` first")
    return idx["skills"]


def cmd_find(args):
    query = words(" ".join(args.words))
    if not query:
        raise Fail("give a few keywords, e.g. `airlock find pdf extract tables`")
    scored = []
    for e in load_index():
        name_w, desc_w = words(e["name"].replace("-", " ")), words(e["description"])
        score = 0.0
        for q in query:
            if q in name_w:
                score += 4
            elif any(w.startswith(q) or (len(w) >= 5 and q.startswith(w)) for w in name_w):
                score += 2.5
            if q in desc_w:
                score += 1.5
            elif len(q) >= 4 and any(w.startswith(q[:5]) for w in desc_w):
                score += 0.75
        if score:
            scored.append((score + TRUST_BOOST.get(e["trust"], 0), e))
    scored.sort(key=lambda x: (-x[0], x[1]["id"]))
    top = scored[: args.limit]
    if args.json:
        print(json.dumps([safe_entry(e, s) for s, e in top], indent=2, ensure_ascii=False))
        return
    if not top:
        print("No matches in the local index. Try other words, or `airlock sync` to refresh.")
        return
    for i, (s, e) in enumerate(top, 1):
        e = safe_entry(e, s)
        print(f"{i:>2}. {e['id']}  [{e['trust']}]  score {s:.1f} · ~{e['desc_tokens']}+{e['body_tokens']} tok"
              f" · scripts: {'yes' if e['has_scripts'] else 'no'} · {e['date'] or e['commit'][:10]}")
        print(f"    {e['description']}")


def safe_entry(e, score):
    """An index entry fit to show an agent: sanitised, and flagged text withheld rather than echoed."""
    flags = e.get("flags") or []
    desc = clean(e["description"], 220)
    if flags:
        desc = (f"[description withheld: {', '.join(flags)}; text aimed at the agent or an invalid name. "
                f"Run `airlock inspect {clean(e['id'], 80)}` to see the evidence.]")
    return {"id": clean(e["id"], 120), "name": clean(e["name"], 64), "trust": clean(e["trust"], 20),
            "source": clean(e["source"], 60), "description": desc, "flags": flags, "score": round(score, 2),
            "has_scripts": e["has_scripts"], "desc_tokens": e["desc_tokens"], "body_tokens": e["body_tokens"],
            "commit": clean(e["commit"], 40), "date": clean(e.get("date") or "", 12)}


# ---------- resolving skills ----------

def resolve_catalog(ref):
    """An index entry by id or unique name, or a local directory."""
    p = Path(ref).expanduser()
    if (p / "SKILL.md").is_file() or (ref.startswith((".", "/", "~")) and p.is_dir()):
        p = p.resolve()
        return {"id": f"local/{qid(p.name)}", "source": "local", "trust": "local", "name": qid(p.name), "path": str(p),
                "commit": "-", "root": p}
    idx = load_index()
    hits = [e for e in idx if e["id"] == ref] or [e for e in idx if e["name"] == ref]
    if not hits:
        raise Fail(f"'{clean(ref, 80)}' is not in the index (try `airlock find`) and is not a skill directory")
    if len(hits) > 1:
        raise Fail(f"'{clean(ref, 80)}' is ambiguous: " + ", ".join(clean(e["id"], 120) for e in hits))
    e = dict(hits[0])
    src = next((s for s in load_sources() if s["id"] == e["source"]), None)
    if src is None:
        raise Fail(f"source '{e['source']}' is no longer in sources.json")
    base = Path(src["path"]).expanduser() if src.get("type") == "path" else STATE / "mirrors" / qid(src["id"])
    e["root"] = base / e["path"]
    if not (e["root"] / "SKILL.md").is_file():
        raise Fail(f"{e['id']} is missing from the mirror: run `airlock sync`")
    return e


def quarantined():
    out = []
    for meta in sorted((STATE / "quarantine").glob("*/meta.json")):
        m = load_json(meta, None)
        if m:
            m["qdir"] = meta.parent
            out.append(m)
    return out


def resolve_quarantine(ref):
    items = quarantined()
    hits = [m for m in items if m["id"] == ref] or [m for m in items if m["name"] == ref]
    if not hits:
        raise Fail(f"'{clean(ref, 80)}' has not been inspected: run `airlock inspect {clean(ref, 80)}` first")
    if len(hits) > 1:
        raise Fail(f"'{clean(ref, 80)}' is ambiguous: " + ", ".join(clean(m["id"], 120) for m in hits))
    m = hits[0]
    if tree_hashes(m["qdir"] / "skill") != m["files"]:
        raise Fail(f"{clean(m['id'], 120)} changed in quarantine after it was inspected: run `airlock inspect` again")
    return m


# ---------- accepted findings and the decision log ----------

# Findings aimed at the agent, not the user: never accepted, whatever the reason.
UNACCEPTABLE = set(_audit.INSTRUCTION_RULES) | {"hidden-unicode", "bidi-control", "unicode-tags", "html-comment",
                                                "unsafe-name"}


def load_accepted():
    return load_json(STATE / "accepted.json", {"accepted": []})


def log_decision(action, skill_id, ids, reason=None):
    """Append-only decision log: one JSON object per line."""
    STATE.mkdir(parents=True, exist_ok=True)
    rec = {"ts": iso(now()), "action": action, "skill": skill_id, "ids": list(ids)}
    if reason is not None:
        rec["reason"] = reason
    with open(STATE / "decisions.jsonl", "a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec, ensure_ascii=False) + "\n")


def apply_accepted(data, skill_id, source, hashes):
    """Mark findings the user accepted for THIS source + skill, if the finding id and the sha256 of every
    file it depends on still match; recompute the verdict. An accepted skill is never CLEAN.
    Returns (data, {id: reason}, stale_count)."""
    mine = {a["finding_id"]: a for a in load_accepted()["accepted"]
            if a.get("skill_id") == skill_id and a.get("source") == source}
    accepted, stale = {}, 0
    for f in data["findings"]:
        f["accepted"] = None
        a = mine.get(f["id"])
        if not a or f["rule"] in UNACCEPTABLE:
            continue
        pinned = a.get("files_sha256") or {}
        if set(f["files_involved"]) <= set(pinned) and all(hashes.get(k) == v for k, v in pinned.items()):
            f["accepted"] = {"reason": a.get("reason", ""), "accepted_at": a.get("accepted_at")}
            accepted[f["id"]] = a.get("reason", "")
        else:
            stale += 1
    counting = [f for f in data["findings"] if not f["accepted"]]
    top = next((sev for sev in _audit.SEVERITIES if any(f["severity"] == sev for f in counting)), None)
    data.setdefault("static_verdict", data["verdict"])
    verdict = _audit.VERDICTS[top]
    data["verdict"] = "OK" if accepted and verdict == "CLEAN" else verdict
    data["accepted_count"] = len(accepted)
    return data, accepted, stale


def effective_verdict(m):
    """The verdict with the user's acceptances applied (falls back to the inspected verdict)."""
    data = load_json(m["qdir"] / "audit.json", None)
    if not data or data.get("tree_sha256") != _audit.tree_digest(m["files"]):
        return m["verdict"]
    data["verdict"] = data.get("static_verdict", data["verdict"])
    return apply_accepted(data, m["id"], m["source"], m["files"])[0]["verdict"]


def cmd_accept(args):
    m = resolve_quarantine(args.skill)
    data = load_json(m["qdir"] / "audit.json", None)
    if not data or data.get("tree_sha256") != _audit.tree_digest(m["files"]):
        raise Fail(f"no current audit for {clean(m['id'], 120)}: run `airlock inspect {clean(m['id'], 120)}` again")
    data["verdict"] = data.get("static_verdict", data["verdict"])
    store = load_accepted()
    sid = clean(m["id"], 120)

    if args.list:
        mine = [a for a in store["accepted"] if a.get("skill_id") == m["id"] and a.get("source") == m["source"]]
        _, live, _ = apply_accepted(json.loads(json.dumps(data)), m["id"], m["source"], m["files"])
        if not mine:
            print(f"No accepted findings for {sid}.")
        for a in mine:
            state = "counts as accepted" if a["finding_id"] in live else "NO LONGER MATCHES (counts again)"
            print(f"  {a['finding_id']}  {a['rule']}  {clean(a['file'], 80)}  {a.get('accepted_at', '?')}  {state}")
            print(f"      reason: {_audit.sanitize(a.get('reason', ''), 200)}")
        return
    if args.revoke:
        before = len(store["accepted"])
        store["accepted"] = [a for a in store["accepted"] if not (a.get("skill_id") == m["id"]
                             and a.get("source") == m["source"] and a["finding_id"] in args.revoke)]
        save_json(STATE / "accepted.json", store)
        log_decision("revoke", m["id"], args.revoke)
        print(f"Revoked {before - len(store['accepted'])} acceptance(s) for {sid}.")
    else:
        by_id = {f["id"]: f for f in data["findings"]}
        if args.rule:
            hits = [f for f in data["findings"] if f["rule"] == args.rule and (not args.file or f["file"] == args.file)]
            if not args.ids:
                print(f"{len(hits)} finding(s) of rule {clean(args.rule, 40)}"
                      + (f" in {clean(args.file, 80)}" if args.file else "") + ". Nothing accepted yet.")
                for f in hits:
                    print(f"  {f['id']}  {f['severity'].upper():6} {f['file']}:{f['line']}  ┊ {f['excerpt']}")
                if hits:
                    print(f"To accept them, after the user has read them: airlock accept {sid} "
                          + " ".join(f["id"] for f in hits) + ' --reason "…"')
                sys.exit(1)   # listed only; nothing accepted
        if not args.ids:
            raise Fail("give the finding ids to accept (`airlock inspect <skill> --json`, or --rule RULE to list them)")
        if not (args.reason or "").strip():
            raise Fail('--reason "…" is required: say why these findings are acceptable')
        unknown = [i for i in args.ids if i not in by_id]
        if unknown:
            raise Fail("not findings of the current audit: " + ", ".join(clean(i, 20) for i in unknown))
        refused = [by_id[i] for i in args.ids if by_id[i]["rule"] in UNACCEPTABLE]
        if refused:
            for f in refused:
                print(f"  REFUSED {f['id']} {f['rule']}: aimed at the agent (instructions, hidden text or the "
                      "skill's name), not at you; it can't be accepted. Use --force only if you decide to.")
            raise Fail("nothing accepted")
        store["accepted"] = [a for a in store["accepted"] if not (a.get("skill_id") == m["id"]
                             and a.get("source") == m["source"] and a["finding_id"] in args.ids)]
        for i in args.ids:
            f = by_id[i]
            store["accepted"].append({
                "skill_id": m["id"], "source": m["source"], "commit": m["commit"], "finding_id": i,
                "rule": f["rule"], "file": f["file"],
                "files_sha256": {p: m["files"][p] for p in f["files_involved"] if p in m["files"]},
                "reason": args.reason.strip(), "accepted_at": iso(now())})
        save_json(STATE / "accepted.json", store)
        log_decision("accept", m["id"], args.ids, args.reason.strip())
    data, accepted, stale = apply_accepted(data, m["id"], m["source"], m["files"])
    save_json(m["qdir"] / "audit.json", data)
    m["verdict"] = data["verdict"]
    save_json(m["qdir"] / "meta.json", {k: v for k, v in m.items() if k != "qdir"})
    for f in data["findings"]:
        if f["accepted"] and (not args.revoke):
            if f["id"] in (args.ids or []):
                print(f"  ACCEPTED {f['severity'].upper()} {f['rule']} {f['file']}:{f['line']} "
                      f"(reason: {_audit.sanitize(f['accepted']['reason'], 120)})")
    note = f" ({len(accepted)} finding(s) accepted by you)" if accepted else ""
    print(f"Verdict for {sid} now: {data['verdict']}{note}; static audit: {data['static_verdict']}.")
    print("An accepted finding comes back as soon as its line or any file it depends on changes.")


def gate(m, force):
    m["verdict"] = effective_verdict(m)
    if m["verdict"] == "BLOCK" and not force:
        raise Fail(f"{clean(m['id'], 120)} has HIGH audit findings (see `airlock inspect {clean(m['id'], 120)}`). "
                   "Not proceeding. Only the user can decide to override with --force.")


# ---------- inspect, audit, use ----------

def audit_json(report, root, skill_id=None, source=None, commit=None):
    return _audit.report_json(report, VERSION, skill_id=skill_id, source=source, commit=commit,
                              tree_sha256=_audit.tree_digest(tree_hashes(root)), audited_at=iso(now()))


def print_json(data):
    print(json.dumps(data, indent=1, ensure_ascii=False))


def cmd_inspect(args):
    e = resolve_catalog(args.skill)
    qdir = STATE / "quarantine" / qid(e["id"])
    if qdir.exists():
        shutil.rmtree(qdir)
    shutil.copytree(e["root"], qdir / "skill", symlinks=True, ignore=shutil.ignore_patterns(".git"))
    report = _audit.audit(qdir / "skill")
    name = report["name"] or e["name"]
    meta = {"id": e["id"], "name": name, "source": e["source"], "trust": e["trust"], "commit": e["commit"],
            "origin": str(e["root"]), "inspected_at": iso(now()), "verdict": report["verdict"],
            "counts": report["counts"], "files": tree_hashes(qdir / "skill"), "uses": []}
    save_json(qdir / "meta.json", meta)
    data = audit_json(report, qdir / "skill", skill_id=e["id"], source=e["source"], commit=e["commit"])
    data, accepted, stale = apply_accepted(data, e["id"], e["source"], meta["files"])
    meta["verdict"] = data["verdict"]
    save_json(qdir / "meta.json", meta)
    save_json(qdir / "audit.json", data)   # the last report, for `accept` and the decision log
    text = _audit.render(report, title=f"{clean(e['id'], 120)} @ {clean(e['commit'], 10)}",
                         accepted=accepted, verdict=data["verdict"])
    if stale:
        text += (f"\n  {stale} earlier acceptance(s) no longer match: the line or a file it depends on changed, "
                 "so those findings count again.")
    (qdir / "audit.txt").write_text(text + "\n", encoding="utf-8")
    if getattr(args, "json", False):
        print_json(data)
        return
    print(text)
    print(f"\nQuarantined at {qdir / 'skill'} (nothing installed).")
    if data["verdict"] == "BLOCK":
        print("Recommendation: do not use. HIGH findings above.")
    else:
        sid = clean(e["id"], 120)
        print(f"Next: `airlock use {sid}` (this task only) or `airlock dock {sid} --temp 7d | --keep`.")


def installed_dirs():
    out = []
    for agent, base in AGENTS.items():
        if base.is_dir():
            for d in sorted(base.iterdir()):
                if (d / "SKILL.md").exists():
                    out.append((agent, d))
    return out


def cmd_audit(args):
    targets = []
    if args.installed:
        targets += [(f"{agent}:{d.name}", d) for agent, d in installed_dirs()]
    meta = {}
    for ref in args.skills:
        p = Path(ref).expanduser()
        if p.is_dir():
            targets.append((ref, p))
        else:
            e = resolve_catalog(ref)
            targets.append((ref, e["root"]))
            meta[ref] = e
    if not targets:
        raise Fail("nothing to audit: give a skill or directory, or --installed")
    summary = []
    as_json = getattr(args, "json", False)
    for label, d in targets:
        r = _audit.audit(d)
        summary.append((label, r))
        if not args.summary and not as_json:
            print(_audit.render(r, title=label) + "\n")
    if as_json:
        reports = []
        for (label, d), (_, r) in zip(targets, summary):
            e = meta.get(label)
            reports.append(audit_json(r, d, skill_id=e["id"] if e else None, source=e["source"] if e else "local",
                                      commit=e["commit"] if e else None) | {"label": label})
        print_json({"schema_version": _audit.SCHEMA_VERSION, "reports": reports})
    elif len(summary) > 1 or args.summary:
        print("Summary")
        for label, r in sorted(summary, key=lambda x: ("BLOCK", "REVIEW", "OK", "CLEAN").index(x[1]["verdict"])):
            c = r["counts"]
            print(f"  {r['verdict']:<6} {label:<40} high {c['high']} · medium {c['medium']} · low {c['low']}")
    if any(r["verdict"] == "BLOCK" for _, r in summary):
        sys.exit(1)


def cmd_use(args):
    m = resolve_quarantine(args.skill)
    gate(m, args.force)
    m["uses"] = (m.get("uses") or [])[-49:] + [iso(now())]
    save_json(m["qdir"] / "meta.json", {k: v for k, v in m.items() if k != "qdir"})
    print(f"ONCE: {clean(m['id'], 120)} (audit {m['verdict']}). Nothing installed; no future session will load it.")
    print(f"Read and follow for this task only: {m['qdir'] / 'skill' / 'SKILL.md'}")
    print(f"Files it refers to are relative to:  {m['qdir'] / 'skill'}")


# ---------- dock, vent, list, verify ----------

def load_lock():
    return load_json(STATE / "lock.json", {"skills": {}})


def cmd_dock(args):
    m = resolve_quarantine(args.skill)
    gate(m, args.force)
    name = m["name"]
    if not SAFE_NAME.match(name):
        raise Fail(f"refusing to install: the skill's frontmatter name is not a valid skill name ({clean(name, 40)!r})")
    agents = [a.strip() for a in args.agent.split(",") if a.strip()]
    for a in agents:
        if a not in AGENTS:
            raise Fail(f"unknown agent '{a}' (known: {', '.join(AGENTS)})")
    lock = load_lock()
    prev = lock["skills"].get(name)
    if prev and prev["id"] != m["id"]:
        raise Fail(f"'{name}' is already docked from {prev['id']}: `airlock vent {name}` first")
    paths = []
    for a in agents:
        dest = AGENTS[a] / name
        if dest.exists() or dest.is_symlink():
            if not prev or str(dest) not in prev["paths"]:
                raise Fail(f"{dest} exists and is not managed by airlock; not touching it")
            _remove(dest, name)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(m["qdir"] / "skill", dest, symlinks=True)
        paths.append(str(dest))
    expires = iso(now() + parse_duration(args.temp)) if args.temp else None
    last = load_json(m["qdir"] / "audit.json", {})   # verdict + finding ids, never the excerpts
    lock["skills"][name] = {"id": m["id"], "source": m["source"], "commit": m["commit"],
                            "mode": "temp" if args.temp else "keep", "expires": expires, "agents": agents,
                            "paths": paths, "docked_at": iso(now()), "verdict": m["verdict"], "files": m["files"],
                            "tree_sha256": last.get("tree_sha256") or _audit.tree_digest(m["files"]),
                            "finding_ids": [f["id"] for f in last.get("findings", [])]}
    save_json(STATE / "lock.json", lock)
    until = f"until {expires}" if expires else "pinned, kept"
    print(f"DOCKED {name} ({m['id']} @ {m['commit'][:10]}, {until}) → {', '.join(paths)}")
    print("New sessions will see it. Remove it any time with `airlock vent " + name + "`.")


def _remove(path, name):
    """Delete an installed skill dir, but only directly inside a known agent skills dir."""
    path = Path(path)
    parents = {Path(os.path.abspath(p)) for p in AGENTS.values()}
    if path.name != name or Path(os.path.abspath(path.parent)) not in parents:
        raise Fail(f"refusing to delete {path}: not an agent skill directory")
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def cmd_vent(args):
    lock = load_lock()
    names = list(args.skills)
    if args.expired:
        t = now()
        names += [n for n, e in lock["skills"].items() if e.get("expires") and parse_iso(e["expires"]) <= t]
    if not names and not args.expired:
        raise Fail("name skills to vent, or use --expired")
    vented, changed = [], False
    for name in dict.fromkeys(names):
        entry = lock["skills"].pop(name, None)
        if entry:
            changed = True
            for p in entry["paths"]:
                _remove(p, name)
        dropped = []
        if not args.keep_quarantine:
            items = quarantined()
            if entry:
                hits = [m for m in items if m["id"] == entry["id"]]
            else:
                hits = [m for m in items if m["id"] == name] or [m for m in items if m["name"] == name]
                if len(hits) > 1:
                    raise Fail(f"'{clean(name, 60)}' matches several quarantined skills: "
                               + ", ".join(clean(m["id"], 120) for m in hits) + ". Vent one by its full id.")
            for m in hits:
                shutil.rmtree(m["qdir"])
                dropped.append(m["id"])
        if entry or dropped:
            vented.append(name)
            if not args.hook:
                where = ", ".join(entry["paths"]) if entry else "quarantine only"
                print(f"VENTED {clean(name, 60)} ({where})")
        elif not args.hook:
            print(f"  '{clean(name, 60)}' is not docked or quarantined; nothing to do")
    if changed:
        save_json(STATE / "lock.json", lock)
    if args.hook and vented:
        print(f"skill-airlock: removed expired temporary skill(s): {', '.join(vented)}")


def cmd_list(args):
    lock = load_lock()["skills"]
    print("Docked")
    if not lock:
        print("  (none)")
    for name, e in sorted(lock.items()):
        until = f"expires {e['expires']}" if e.get("expires") else "kept"
        print(f"  {clean(name, 40):<28} {e['mode']:<5} {until:<32} {e['verdict']:<6} {clean(e['id'], 80)} → {', '.join(e['agents'])}")
    print("Quarantine")
    items = quarantined()
    if not items:
        print("  (none)")
    for m in items:
        used = f"used {len(m.get('uses') or [])}×" if m.get("uses") else "not used"
        print(f"  {clean(m['id'], 60):<44} {m['verdict']:<6} inspected {m['inspected_at'][:10]} · {used}")


def cmd_verify(args):
    bad = 0
    lock = load_lock()["skills"]
    if not lock:
        print("Nothing docked.")
    for name, e in sorted(lock.items()):
        for p in e["paths"]:
            if not Path(p).is_dir():
                print(f"  MISSING  {name}  {p}")
                bad += 1
                continue
            now_h = tree_hashes(p)
            changed = sorted(k for k in set(now_h) | set(e["files"]) if now_h.get(k) != e["files"].get(k))
            if changed:
                bad += 1
                print(f"  CHANGED  {name}  {p}: {', '.join(changed[:8])}{' …' if len(changed) > 8 else ''}")
            else:
                print(f"  OK       {name}  {p}")
    sys.exit(1 if bad else 0)


# ---------- budget ----------

def skill_usage(days):
    """Last use per skill name from local Claude Code transcripts (read locally, never stored)."""
    last = {}
    if not TRANSCRIPTS.is_dir():
        return last
    cutoff = time.time() - days * 86400
    for f in TRANSCRIPTS.rglob("*.jsonl"):
        try:
            if f.stat().st_mtime < cutoff:
                continue
            with open(f, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if '"Skill"' not in line and "<command-name>" not in line:
                        continue
                    try:
                        obj = json.loads(line)
                    except ValueError:
                        continue
                    ts = obj.get("timestamp") or ""
                    for name in _names_in(obj):
                        if ts > last.get(name, ""):
                            last[name] = ts
        except OSError:
            continue
    return last


def _names_in(obj):
    content = (obj.get("message") or {}).get("content")
    items = content if isinstance(content, list) else [content]
    for it in items:
        if isinstance(it, dict) and it.get("type") == "tool_use" and it.get("name") == "Skill":
            s = (it.get("input") or {}).get("skill")
            if isinstance(s, str):
                yield s.split(":")[-1].lstrip("/")
        text = it.get("text") if isinstance(it, dict) else it
        if isinstance(text, str):
            for m in re.finditer(r"<command-name>/?([\w:.-]+)</command-name>", text):
                yield m.group(1).split(":")[-1]


def cmd_budget(args):
    lock = load_lock()["skills"]
    usage = skill_usage(args.days)
    rows = []
    for agent, d in installed_dirs():
        with open(d / "SKILL.md", encoding="utf-8", errors="replace") as fh:
            text = fh.read()
        meta, body_start = _audit.parse_frontmatter(text)
        name = clean(meta.get("name") or d.name, 40)
        rows.append({"agent": agent, "dir": d.name, "name": name, "desc": meta.get("description", ""),
                     "dt": _audit.tokens(name + meta.get("description", "")),
                     "bt": _audit.tokens("\n".join(text.splitlines()[body_start:])),
                     "last": usage.get(name) or usage.get(d.name), "lock": lock.get(d.name)})
    if not rows:
        print("No skills installed in " + ", ".join(str(p) for p in AGENTS.values()))
        return
    print(f"{'skill':<28} {'agent':<7} {'tok/session':>11} {'on use':>8}  {'last used':<10} airlock")
    for r in sorted(rows, key=lambda r: -r["dt"]):
        lk = r["lock"]
        tag = "-" if not lk else (f"temp → {lk['expires'][:10]}" if lk["mode"] == "temp" else "keep")
        print(f"{r['name'][:28]:<28} {r['agent']:<7} {r['dt']:>11,} {r['bt']:>8,}  {human_age(r['last'], args.days):<10} {tag}")
    per_session = sum(r["dt"] for r in rows if r["agent"] == "claude")
    print(f"\nClaude Code: {sum(1 for r in rows if r['agent'] == 'claude')} skills · ~{per_session:,} tokens in every session"
          f" for names+descriptions; bodies load only on use.")
    unused = [r for r in rows if r["agent"] == "claude" and not r["last"]]
    if unused:
        cost = sum(r["dt"] for r in unused)
        print(f"Not used in the last {args.days} days (from local transcripts): "
              f"{', '.join(r['name'] for r in unused)}  (~{cost:,} tok/session)")
        managed = [r["dir"] for r in unused if r["lock"]]
        if managed:
            print(f"  → `airlock vent {' '.join(managed)}`")
        if len(managed) < len(unused):
            print("  Skills not docked by airlock are left alone; remove them by hand if you no longer need them.")
    pairs = []
    for i, a in enumerate(rows):
        for b in rows[i + 1:]:
            wa, wb = words(a["desc"]), words(b["desc"])
            if len(wa) >= 5 and len(wb) >= 5 and a["name"] != b["name"]:
                j = len(wa & wb) / len(wa | wb)
                if j >= args.overlap:
                    pairs.append((j, a["name"], b["name"]))
    if pairs:
        print("Similar descriptions (may compete to trigger):")
        for j, a, b in sorted(pairs, reverse=True)[:10]:
            print(f"  {a} ↔ {b}  ({j:.0%} shared words)")
    print("Not counted yet: plugin skills and built-in skills.")


# ---------- main ----------

def main(argv=None):
    p = argparse.ArgumentParser(prog="airlock", description="Find, vet, use and unload agent skills, privately.")
    p.add_argument("--version", action="version", version=f"skill-airlock {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sync", help="mirror the catalogs in sources.json and rebuild the local index")
    s.add_argument("only", nargs="*", help="sync only these source ids")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("find", help="search the local index (offline; the query is never stored or sent)")
    s.add_argument("words", nargs="+")
    s.add_argument("--limit", type=int, default=10)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_find)

    s = sub.add_parser("inspect", help="copy a skill into quarantine and audit it")
    s.add_argument("skill", help="index id, unique name, or a local skill directory")
    s.add_argument("--json", action="store_true", help="print the audit report as one JSON document (docs/audit-schema.json)")
    s.set_defaults(fn=cmd_inspect)

    s = sub.add_parser("audit", help="audit skills in place (any directory, or everything installed)")
    s.add_argument("skills", nargs="*")
    s.add_argument("--installed", action="store_true", help="audit every skill in the agents' skill directories")
    s.add_argument("--summary", action="store_true", help="one line per skill")
    s.add_argument("--json", action="store_true", help='print {"reports": [...]} as one JSON document (docs/audit-schema.json)')
    s.set_defaults(fn=cmd_audit)

    s = sub.add_parser("accept", help="accept specific findings of a quarantined skill, pinned to their content")
    s.add_argument("skill")
    s.add_argument("ids", nargs="*", help="finding ids from `airlock inspect <skill> --json`")
    s.add_argument("--reason", help="why these findings are acceptable (required to accept)")
    s.add_argument("--rule", help="list the findings of this rule (with --file: in that file) and their ids")
    s.add_argument("--file", help="with --rule: only this file")
    s.add_argument("--list", action="store_true", help="show what you accepted for this skill")
    s.add_argument("--revoke", nargs="+", metavar="ID", help="withdraw acceptances")
    s.set_defaults(fn=cmd_accept)

    s = sub.add_parser("use", help="once mode: use a quarantined skill for this task only, install nothing")
    s.add_argument("skill")
    s.add_argument("--force", action="store_true", help="override a BLOCK verdict (user decision only)")
    s.set_defaults(fn=cmd_use)

    s = sub.add_parser("dock", help="install a quarantined skill")
    s.add_argument("skill")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--temp", metavar="DURATION", help="temporary install, e.g. 7d; removed by `vent --expired`")
    g.add_argument("--keep", action="store_true", help="permanent install, pinned to the inspected commit")
    s.add_argument("--agent", default="claude", help="comma list of: " + ", ".join(AGENTS) + " (default: claude)")
    s.add_argument("--force", action="store_true", help="override a BLOCK verdict (user decision only)")
    s.set_defaults(fn=cmd_dock)

    s = sub.add_parser("vent", help="remove docked or quarantined skills")
    s.add_argument("skills", nargs="*")
    s.add_argument("--expired", action="store_true", help="remove all expired temporary installs")
    s.add_argument("--keep-quarantine", action="store_true", help="uninstall but keep the quarantined copy")
    s.add_argument("--hook", action="store_true", help="quiet mode for a SessionStart hook; never fails")
    s.set_defaults(fn=cmd_vent)

    s = sub.add_parser("list", help="show docked and quarantined skills")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("verify", help="check docked skills against the hashes recorded at install")
    s.set_defaults(fn=cmd_verify)

    s = sub.add_parser("budget", help="context cost of installed skills, unused ones, overlaps")
    s.add_argument("--days", type=int, default=30)
    s.add_argument("--overlap", type=float, default=0.4, help="shared-word ratio that counts as overlap")
    s.set_defaults(fn=cmd_budget)

    args = p.parse_args(argv)
    try:
        args.fn(args)
    except Fail as e:
        if getattr(args, "hook", False):
            return 0
        print(f"airlock: {e}", file=sys.stderr)
        return 2
    except Exception:
        if getattr(args, "hook", False):
            return 0
        raise
    return 0


if __name__ == "__main__":
    sys.exit(main())
